function flatten2(acc: String, input: Dynamic): Map =
    input.toMap().flatMap((key, value) -> 
        if (value is Dynamic)
            flatten2("\(acc).\(key)", value)
        else Map("\(acc).\(key)", value)
    )

project_name    = "palao"
project_stage   = "production"
project_service = "backend"

project_reference = "\(project_name)-\(project_stage)-\(project_service)"
project_database  = "\(project_name)-\(project_stage)-postgres"
project_network   = "\(project_name)-\(project_stage)-network"


services {
    [project_reference] {
        image = "test"
        container_name = project_reference
        restart = "unless-stopped"
        depends_on {
            project_database
        }
        environment {
            TZ = "America/Lima"
        }
        env_file {
            ".env.backend"
            ".env.database"
        }
        networks {
            "traefik3_proxy"
            project_network
        }
        labels {
            for (key, value in flatten2("traefik", project_traefik)) {
                "\(key)=\(value)"
            }
        }
        healthcheck {
            test {
                "CMD-SHELL"
                "curl -f http://localhost:6000/api/health || exit 1"
            }
            interval = "10s"
            timeout  = "5s"
            retries  = 5
            start_period = "30s"
        }
    }
}

project_traefik {
    enable = true
    docker {
        allownonrunning = true
    }
    http {
        middlewares {
            [project_name] {
                plugin {
                    sablier {
                        group = "hotswap"
                        sablierUrl = "http://sablier:10000"
                        sessionDuration = "1m"
                    }
                }
            }
        }
        routers {
            [project_name] {
                rule = "Host(`\(project_name).dev.acide.win`)"
                middlewares = project_name
                entrypoints = "websecure"
                tls {
                    enable = true
                    certresolver = "cloudflare-wildcard"
                    domains {
                        main = "acide.win"
                        sans = "*.dev.acide.win"
                    }
                }
            }
        }
        services {
            [project_name] {
                loadbalancer {
                    server {
                        port = 80
                    }
                }
            }
        }
    }
}

output {
    value = new Dynamic {
        ["services"] = services
    }
}
